### Visual
# theme
theme = Rapture
window-theme = system
unfocused-split-opacity = 0.6

# font
font-family = JetBrains Mono
font-size = 13.5
font-thicken = true
font-feature = -liga

# background
background-blur = true
background-opacity = 0.75
background-blur-radius = 90

# colors
# window-colorspace = srgb
window-colorspace = display-p3

# macos-only
macos-non-native-fullscreen = true
macos-titlebar-style = tabs
macos-icon = retro
fullscreen = true


### Keybindings
# super==cmd, alt==opt

# open little ghostty
keybind = global:ctrl+shift+grave_accent=toggle_quick_terminal
# move between tabs is cmd+alt+arrow
keybind = super+alt+left=previous_tab
keybind = super+alt+right=next_tab
# move between panes is cmd+arrow
keybind = super+left=goto_split:previous
keybind = super+right=goto_split:next
# new line
keybind = shift+enter=text:\n


### Misc
quit-after-last-window-closed = true
window-new-tab-position = end
copy-on-select = clipboard
focus-follows-mouse = true
mouse-hide-while-typing = true
