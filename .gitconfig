[user]
	name = Azmain Adel
	email = azmainadel47@gmail.cpom
[core]
	editor = nano
[init]
	defaultBranch = main
[alias]
	st = status -sb
	co = checkout
	br = branch
	lg = log --oneline --graph --decorate --all
	unstage = reset HEAD --
	last = log -1 HEAD --stat

[pull]
	rebase = true
	autoStash = true

[fetch]
	prune = true

[push]
	autoSetupRemote = true
